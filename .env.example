# Application
PORT=4000
JWT_SECRET=replace-with-strong-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id

# Database
DATABASE_URL=postgresql://email_scheduler:email_scheduler_pass@localhost:5432/email_scheduler_db?schema=public
POSTGRES_USER=email_scheduler
POSTGRES_PASSWORD=email_scheduler_pass
POSTGRES_DB=email_scheduler_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP / Ethereal
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=replace-with-ethereal-user
SMTP_PASS=replace-with-ethereal-pass

# Worker / Queue controls
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=100
MIN_DELAY_SECONDS=5

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api/v1
